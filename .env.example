# Configuration AVA — copier vers .env puis renseigner

# Serveur SMTP pour l'envoi réel des mails de validation.
# Sans ces variables, les mails sont uniquement journalisés dans l'application
# (page « Mails » d'un projet) pour tester le workflow sans serveur de messagerie.
AVA_SMTP_HOST=smtp.example.com
AVA_SMTP_PORT=587
AVA_SMTP_TLS=1
AVA_SMTP_USER=
AVA_SMTP_PASSWORD=
AVA_SMTP_SENDER=ava@example.com

# Clé secrète de session (obligatoire en production)
AVA_SECRET_KEY=

# Base de données et serveur
AVA_DB_PATH=ava.db
AVA_PORT=5000
AVA_DEBUG=0
